#!/usr/bin/env bash
# Starts the game and its tools (one local server: tools/serve.py) in the background.
#   ./barnyard            start (same as ./barnyard start)
#   ./barnyard restart    stop, then start again (after changing serve.py, or if it hangs)
#   ./barnyard stop       stop it
#   ./barnyard status     is it running, and where
#   ./barnyard log        follow the server's log
# PORT=8080 ./barnyard picks another port. The page reads data/ fresh on every reload, so editing JSON
# never needs a restart.
set -u
cd "$(dirname "$(readlink -f "$0")")" || exit 1
PORT="${PORT:-8000}"
PIDFILE="tools/.server.pid"
LOG="tools/server.log"

running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }
urls() {
  echo "  Game:            http://localhost:$PORT/"
  echo "  Talent creator:  http://localhost:$PORT/tools/talents/"
  echo "  Balance lab:     http://localhost:$PORT/tools/balance.html"
  echo "  Showcase:        http://localhost:$PORT/tools/showcase/"
}
start() {
  if running; then echo "Already running (pid $(cat "$PIDFILE"))."; urls; return 0; fi
  nohup python3 tools/serve.py --port "$PORT" > "$LOG" 2>&1 &
  echo $! > "$PIDFILE"
  for _ in $(seq 1 30); do
    if curl -s -o /dev/null "http://localhost:$PORT/api/ping"; then echo "Barnyard Reaper is up (pid $(cat "$PIDFILE"))."; urls; return 0; fi
    if ! running; then break; fi
    sleep 0.1
  done
  echo "The server did not start. Last lines of $LOG:"; tail -n 5 "$LOG"; rm -f "$PIDFILE"; return 1
}
stop() {
  if running; then
    kill "$(cat "$PIDFILE")"
    for _ in $(seq 1 30); do running || break; sleep 0.1; done
    echo "Stopped."
  else
    echo "Not running."
  fi
  rm -f "$PIDFILE"
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) if running; then echo "Running (pid $(cat "$PIDFILE"))."; urls; else echo "Not running."; fi ;;
  log) tail -f "$LOG" ;;
  *) echo "Usage: ./barnyard [start|stop|restart|status|log]"; exit 1 ;;
esac
